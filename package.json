{
  "name": "threadferry",
  "version": "0.32.7",
  "description": "Ferry enterprise chat context to native local AI agents with isolated identities and controlled WeCom actions.",
  "author": "GnaixEuy",
  "homepage": "https://github.com/GnaixEuy/threadferry",
  "desktopName": "threadferry.desktop",
  "type": "module",
  "main": "dist/src/desktop.js",
  "bin": {
    "threadferry": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "README.zh-CN.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs/assets/threadferry-hero-v2.png",
    "docs/assets/threadferry-poster.png",
    "docs/assets/threadferry-architecture.png",
    "POC.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "threadferry.example.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node --eval \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "1.0.7",
    "cross-spawn": "7.0.6",
    "electron-updater": "6.8.9",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.0.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "build": {
    "appId": "com.threadferry.desktop",
    "productName": "ThreadFerry",
    "artifactName": "ThreadFerry-${version}-${os}-${arch}.${ext}",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN"
    ],
    "directories": {
      "buildResources": "build",
      "output": "release/desktop"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "GnaixEuy",
        "repo": "threadferry"
      }
    ],
    "files": [
      "dist/src/**/*.js",
      "build/desktop-preload.cjs",
      "build/tray*.png",
      "package.json",
      "!**/*.d.ts",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "notarize": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "GnaixEuy",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "license": "MIT"
}
