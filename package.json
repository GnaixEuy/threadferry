{
  "name": "threadferry",
  "version": "0.25.1",
  "description": "Safely ferry enterprise chat context to read-only local AI agents.",
  "type": "module",
  "bin": {
    "threadferry": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/assets/threadferry-hero-v2.png",
    "docs/assets/threadferry-poster.png",
    "POC.md",
    "LICENSE",
    "install.sh",
    "install.ps1",
    "threadferry.example.yaml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc && node --eval \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@wecom/aibot-node-sdk": "1.0.7",
    "cross-spawn": "7.0.6",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
